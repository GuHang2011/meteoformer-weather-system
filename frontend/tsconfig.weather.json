{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Node",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"types": ["vite/client"],
		"allowSyntheticDefaultImports": true,
		"noEmit": true
	},
	"include": ["src/main.ts", "src/weather/**/*.ts", "src/weather/**/*.vue"]
}
